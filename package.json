{
  "name": "krishna-ai-assistant-pro",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Krishna Jarvis Pro Max 50%+: realtime voice, wake word, screen AI, camera vision, coding agent, memory, web search hooks, desktop control, mobile URL and multi-agent dashboard.",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "vite --host 0.0.0.0 --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "reset:memory": "node server/reset-memory.js",
    "desktop": "concurrently -k \"npm run server\" \"npm run client\" \"npm run electron:wait\"",
    "electron:wait": "wait-on http://localhost:5173 && electron .",
    "desktop:server": "npm run server",
    "desktop:client": "npm run client",
    "build:desktop": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "express": "latest",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "openai": "latest",
    "pdf-parse": "^2.4.5",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-speech-recognition": "^4.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "latest",
    "remark-gfm": "^4.0.1",
    "vite": "latest",
    "wait-on": "latest"
  },
  "main": "electron/main.cjs"
}
